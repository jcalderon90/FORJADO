      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ (() => { const ch = $('Evaluar Estado Recontacto').item.json.input_channel; if (ch === 'instagram') return { type: 'IG' }; if (ch === 'messenger') return { type: 'FB' }; if (ch === 'sms') return { type: 'SMS' }; const conv = ($json.conversations && $json.conversations[0]) || {}; const lastType = (conv.lastMessageType || '').toUpperCase(); const map = {'TYPE_SMS':'SMS','TYPE_CAMPAIGN_SMS':'SMS','TYPE_SMS_REVIEW_REQUEST':'SMS','TYPE_SMS_NO_SHOW_REQUEST':'SMS','TYPE_EMAIL':'Email','TYPE_CAMPAIGN_EMAIL':'Email','TYPE_FACEBOOK':'FB','TYPE_CAMPAIGN_FACEBOOK':'FB','TYPE_INSTAGRAM':'IG','TYPE_WHATSAPP':'WhatsApp','TYPE_WEBCHAT':'Live_Chat'}; if (map[lastType]) return { type: map[lastType] }; if (conv.phone) return { type: 'WhatsApp' }; if (conv.email) return { type: 'Email' }; return { type: 'Live_Chat' }; })() }}",
