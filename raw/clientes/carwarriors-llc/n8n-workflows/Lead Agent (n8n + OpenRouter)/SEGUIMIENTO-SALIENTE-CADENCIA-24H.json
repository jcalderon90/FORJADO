    {
      "id": "f0eef732-9583-4876-91b1-2e8371f8681e",
      "name": "Armar Mensaje Intento 1",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        2940,
        400
      ],
      "parameters": {
        "jsonOutput": "={{ (() => { const cand = $('Evaluar Estado Recontacto').item.json; const es = cand.language !== 'en'; const iv = cand.interes_vehiculo; const intento = cand.intento || 1; let msgEs = ''; let msgEn = ''; if (intento === 1) { msgEs = \"¡Hola! Vi que estabas interesado\" + (iv ? \" en el \" + iv : \"\") + \". Tengo disponibilidad hoy para que lo veas — ¿te queda mejor a las 4pm o a las 6pm?\"; msgEn = \"Hi! I saw you were interested\" + (iv ? \" in the \" + iv : \"\") + \". I have availability today for you to see it — does 4pm or 6pm work better?\"; } else if (intento === 2) { msgEs = \"¡Hola! ¿Pudiste revisar los horarios? Si prefieres, te puedo ir adelantando las opciones con $0 de inicial\" + (iv ? \" para el \" + iv : \"\") + \" o apartarte un espacio para mañana por la mañana. ¿Qué te queda mejor?\"; msgEn = \"Hi! Were you able to check the schedule? If you prefer, I can share our $0 down payment options\" + (iv ? \" for the \" + iv : \"\") + \" or reserve a spot for tomorrow morning. Which works better for you?\"; } else { msgEs = \"¡Hola! Como no tuvimos respuesta, asumí que ya resolviste o pausaste la búsqueda del auto. Avísame si aún te interesa\" + (iv ? \" el \" + iv : \" ver opciones\") + \" para guardarte el turno antes de cerrarlo, o si prefieres que no te contactemos más.\"; msgEn = \"Hi! Since we didn't hear back, I assumed you found another option or paused your search. Let me know if you're still interested\" + (iv ? \" in the \" + iv : \"\") + \" so I can save your spot before closing it out, or if you prefer no further messages.\"; } return { type: $json.type, message: es ? msgEs : msgEn }; })() }}",
        "mode": "raw"
      }
    },
