      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('START').item.json.contactId }}",
        "collectionName": "chat_histories_lead",
        "databaseName": "Carwarriors",
        "contextWindowLength": 10
      },
      "type": "@n8n/n8n-nodes-langchain.memoryMongoDbChat",
      "typeVersion": 1,
