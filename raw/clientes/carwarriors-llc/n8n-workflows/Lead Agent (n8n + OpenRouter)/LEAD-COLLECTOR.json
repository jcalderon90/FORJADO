    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output || '';\nconst ctx = $('SET CONTEXT').first().json;\n\nfunction normalizePhone(raw) {\n  if (!raw) return '';\n  const trimmed = String(raw).trim();\n  const digits = trimmed.replace(/[^\\d]/g, '');\n  if (trimmed.startsWith('+') && digits.length >= 10) return '+' + digits;\n  if (digits.length === 10) return '+1' + digits;\n  if (digits.length === 11 && digits.startsWith('1')) return '+' + digits;\n  return ''; // formato no reconocible -- no lo mandamos a GHL para evitar basura\n}\n\nfunction fallback() {\n  return [{\n    json: {\n      city: ctx.city_actual || '',\n      interes_vehiculo: ctx.interes_vehiculo_actual || '',\n      metodo_pago: ctx.metodo_pago_actual || '',\n      timing_compra: ctx.timing_actual || '',\n      idioma_preferido: ctx.idioma_actual || '',\n      telefono: ctx.telefono_actual || '',\n      telefono_intentos: ctx.telefono_intentos_actual || '0',\n      telefono_dejar_de_pedir: ctx.telefono_dejar_de_pedir_actual || 'false',\n      resumen_ai: ctx.resumen_actual || '',\n      response: ''\n    }\n  }];\n}\n\n// deepseek-v4-flash a veces genera un rambling de razonamiento antes de la respuesta final,\n// repitiendo el JSON de salida varias veces (mismo patron visto en KB-SEARCH el 2026-08-31).\n// Tomar 'primer { a ultimo }' del texto completo mezcla varios bloques y JSON.parse falla.\n// En vez de eso: extraer TODOS los bloques JSON planos y quedarnos con el ULTIMO que parsea\n// Y tiene la clave 'telefono' -- es la version final y mas confiable del modelo.\nfunction extraerJson(texto) {\n  const candidatos = texto.match(/\\{[^{}]*\\}/g) || [];\n  for (let i = candidatos.length - 1; i >= 0; i--) {\n    try {\n      const obj = JSON.parse(candidatos[i]);\n      if (Object.prototype.hasOwnProperty.call(obj, 'telefono')) return obj;\n    } catch (e) { /* seguir probando candidatos anteriores */ }\n  }\n  return null;\n}\n\nconst parsed = extraerJson(raw);\nif (!parsed) {\n  return fallback();\n}\n\nconst telefonoNuevo = normalizePhone(parsed.telefono);\nconst telefonoFinal = telefonoNuevo || ctx.telefono_actual || '';\n\nlet intentos = parseInt(ctx.telefono_intentos_actual || '0', 10) || 0;\nconst dejarDePedirPrevio = ctx.telefono_dejar_de_pedir_actual === 'true';\nlet dejarDePedir = dejarDePedirPrevio;\nlet justGaveUp = false;\n\n// Contador deterministico -- no confiamos en que el LLM cuente bien los intentos.\n// Solo avanza mientras el telefono siga faltando y todavia no nos hayamos rendido antes.\nif (!telefonoFinal && !dejarDePedirPrevio) {\n  if (parsed.rechazo_explicito === true) {\n    dejarDePedir = true;\n    justGaveUp = true;\n  } else {\n    intentos = intentos + 1;\n    if (intentos >= 3) {\n      dejarDePedir = true;\n      justGaveUp = true;\n    }\n  }\n}\n\nlet respuesta = parsed.response || '';\nif (justGaveUp) {\n  const ingles = (parsed.idioma_preferido || ctx.idioma_actual || '').toLowerCase().includes('engl');\n  respuesta = ingles\n    ? \"No worries, let's continue -- how can I help? 😊\"\n    : \"Sin problema, seguimos igual 😊 ¿en que te ayudo?\";\n}\n\nreturn [{\n  json: {\n    city: parsed.city || ctx.city_actual || '',\n    interes_vehiculo: parsed.interes_vehiculo || ctx.interes_vehiculo_actual || '',\n    metodo_pago: parsed.metodo_pago || ctx.metodo_pago_actual || '',\n    timing_compra: parsed.timing_compra || ctx.timing_actual || '',\n    idioma_preferido: parsed.idioma_preferido || ctx.idioma_actual || '',\n    telefono: telefonoFinal,\n    telefono_intentos: String(intentos),\n    telefono_dejar_de_pedir: String(dejarDePedir),\n    resumen_ai: parsed.resumen_ai || ctx.resumen_actual || '',\n    response: respuesta\n  }\n}];"
      },
