    {
      "id": "caeb53a9-a874-43f7-8c59-8262f228f9db",
      "name": "Merge Lead Master",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        420
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const pu = $('Prepare Update').first().json;\nconst ctx = $('SET CONTEXT').first().json;\nconst foundItems = $input.all();\nconst existing = foundItems.length ? foundItems[0].json : null;\n\nconst now = new Date().toISOString();\nconst dealer = ctx.dealer || pu.dealer || '';\n\nconst nuevaFuente = {\n  dealer: dealer,\n  locationId: ctx.locationId || '',\n  contactId: pu.contactId,\n  canal: ctx.canal || '',\n  primeraEntrada: now,\n  ultimaEntrada: now\n};\n\nlet fuentes = (existing && Array.isArray(existing.fuentes)) ? existing.fuentes.slice() : [];\nconst idx = fuentes.findIndex(f => f.dealer === nuevaFuente.dealer && f.contactId === nuevaFuente.contactId);\nlet esFuenteNueva = false;\nif (idx >= 0) {\n  fuentes[idx] = Object.assign({}, fuentes[idx], { ultimaEntrada: now });\n} else {\n  fuentes.push(nuevaFuente);\n  esFuenteNueva = true;\n}\n\nconst dealersUnicos = [...new Set(fuentes.map(f => f.dealer))];\nconst multiDealer = dealersUnicos.length > 1;\nconst nuevoMatchCrossDealer = esFuenteNueva && multiDealer;\n\nreturn [{\n  json: {\n    telefono: pu.telefono,\n    city: pu.city,\n    interes_vehiculo: pu.interes_vehiculo,\n    metodo_pago: pu.metodo_pago,\n    timing_compra: pu.timing_compra,\n    idioma_preferido: pu.idioma_preferido,\n    resumen_ai: pu.resumen_ai,\n    fuentes: fuentes,\n    dealers: dealersUnicos,\n    multiDealer: multiDealer,\n    nuevoMatchCrossDealer: nuevoMatchCrossDealer,\n    createdAt: (existing && existing.createdAt) ? existing.createdAt : now,\n    updatedAt: now\n  }\n}];"
      }
    },
