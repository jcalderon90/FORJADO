  "nodes": [
    {
      "parameters": {
        "jsCode": "const trigger = $('START').first().json;\nconst dealer = trigger.dealer || \"\";\nconst tipoRaw = String(trigger.tipo_media || \"\").toLowerCase().trim();\nconst tipo = tipoRaw || \"bienvenida\";\nconst canal = (trigger.canal || \"whatsapp\").toLowerCase().trim();\nconst modelo = String(trigger.modelo || \"\").trim();\n\nfunction normalize(s) {\n  return String(s || '').toUpperCase().replace(/[^A-Z0-9 ]/g, ' ').replace(/\\s+/g, ' ').trim();\n}\n\nlet url = null;\nlet caption = 'Aqui tienes';\n\nif (tipo === \"vehiculo\" && modelo) {\n  const rows = $input.all().map(i => i.json);\n  const modeloWords = normalize(modelo).split(' ').filter(w => w.length >= 3);\n  let best = null;\n  let bestScore = 0;\n  for (const row of rows) {\n    const titleNorm = normalize(row.vehicle_title);\n    const score = modeloWords.filter(w => titleNorm.includes(w)).length;\n    if (score > bestScore) {\n      bestScore = score;\n      best = row;\n    }\n  }\n  // Exigir al menos 2 palabras coincidentes (ej. marca + modelo) para evitar falsos positivos\n  if (best && bestScore >= 2) {\n    url = best.photo_url;\n    caption = best.vehicle_title || caption;\n  }\n}\n// tipo === 'bienvenida' u otros: sin fuente de datos todavia, queda sin media (rama segura ya existente)\n\nreturn [{\n  json: {\n    contactId: trigger.contactId,\n    canal,\n    dealer,\n    media_disponible: url !== null,\n    attachments: url ? [url] : [],\n    caption\n  }\n}];",
        "mode": "runOnceForAllItems"
      },
