{
  "name": "META-COMENTARIOS-GRAPH-API",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "ALL",
        "path": "meta-webhook-comentarios",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000001",
      "name": "Webhook Meta (GET/POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "webhookId": "meta-webhook-comentarios"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.headers['x-forwarded-method'] || $json.method || ($json.query && $json.query['hub.challenge'] ? 'GET' : 'POST') }}",
              "rightValue": "GET",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1b2c3d4-2222-4000-8000-000000000002",
      "name": "¿Es Handshake GET?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1b2c3d4-3333-4000-8000-000000000003",
      "name": "Responder Challenge GET",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        700,
        180
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"status\": \"received\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1b2c3d4-4444-4000-8000-000000000004",
      "name": "Responder 200 OK a Meta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        700,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst entry = body.entry?.[0];\nconst change = entry?.changes?.[0];\nconst field = change?.field;\nconst value = change?.value || {};\n\nlet comentario = '';\nlet comment_id = '';\nlet from_id = '';\nlet from_name = '';\nlet canal = '';\nlet parent_id = '';\n\nif (field === 'comments') {\n  canal = 'instagram';\n  comment_id = value.id || '';\n  comentario = value.text || '';\n  from_id = value.from?.id || '';\n  from_name = value.from?.username || '';\n  parent_id = value.media?.id || '';\n} else if (field === 'feed') {\n  canal = 'facebook';\n  if (value.item === 'comment' && value.verb === 'add') {\n    comment_id = value.comment_id || '';\n    comentario = value.message || '';\n    from_id = value.from?.id || '';\n    from_name = value.from?.name || '';\n    parent_id = value.post_id || '';\n  }\n}\n\nif (!comment_id || !comentario) {\n  return [];\n}\n\nreturn [{\n  json: {\n    canal,\n    comment_id,\n    comentario,\n    from_id,\n    from_name,\n    parent_id,\n    raw_value: value\n  }\n}];"
      },
      "id": "a1b2c3d4-5555-4000-8000-000000000005",
      "name": "Extraer Comentario y Metadatos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        420
      ]
    },
    {
      "parameters": {
        "schemaType": "fromAttributes",
        "attributes": {
          "attributes": [
            {
              "name": "es_interes_real",
              "type": "boolean",
              "description": "Devuelve true SOLO si el comentario muestra interés real de compra de un vehículo: pregunta por precio, disponibilidad, financiamiento, quiere agendar una cita/visita, o pide información de un auto específico (marca, modelo, año). Devuelve false para comentarios genéricos, emojis, cumplidos (\"bonito auto\"), etiquetas a otras personas, comentarios no relacionados a intención de compra, o pedidos de regalos/sorteos/promociones gratuitas.",
              "required": true
            },
            {
              "name": "idioma",
              "type": "string",
              "description": "Código de idioma detectado en el texto del comentario: 'es' si está en español, 'en' si está en inglés. Si no puedes determinarlo con certeza o es otro idioma distinto, usa 'es' por defecto.",
              "required": true
            },
            {
              "name": "vehiculo_mencionado",
              "type": "string",
              "description": "Marca, modelo o tipo de vehículo mencionado en el comentario (ejemplo: 'Toyota Tacoma', 'Mustang', 'Corolla', 'camioneta', 'SUV'). Si no menciona ningún vehículo específico, devuelve cadena vacía.",
              "required": false
            }
          ]
        },
        "text": "={{ $json.comentario }}"
      },
      "id": "a1b2c3d4-6666-4000-8000-000000000006",
      "name": "Clasificar Interés Real",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        1180,
        420
      ]
    },
    {
      "parameters": {
        "model": "deepseek/deepseek-v4-flash",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "a1b2c3d4-7777-4000-8000-000000000007",
      "name": "OpenRouter Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        1180,
        600
      ],
      "credentials": {
        "openRouterApi": {
          "id": "o8MexJvFeSx2j4an",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c_interes",
              "leftValue": "={{ !!$json.output?.es_interes_real }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1b2c3d4-8888-4000-8000-000000000008",
      "name": "¿Tiene Interés Real?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1440,
        420
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "comment_id",
              "value": "={{ $('Extraer Comentario y Metadatos').item.json.comment_id }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "canal",
              "value": "={{ $('Extraer Comentario y Metadatos').item.json.canal }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "respuesta_publica",
              "value": "={{ $json.output?.idioma === 'en' ? 'Thanks for your interest! 🚗 We just sent you a private message with all the details.' : '¡Gracias por tu interés! 🚗 Te escribimos por mensaje privado con toda la información.' }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "respuesta_dm",
              "value": "={{ (() => {\n  const nombre = $('Extraer Comentario y Metadatos').item.json.from_name;\n  const isEn = $json.output?.idioma === 'en';\n  const auto = ($json.output?.vehiculo_mencionado || '').trim();\n\n  if (isEn) {\n    const saludo = nombre ? 'Hi ' + nombre + '!' : 'Hi!';\n    const autoTxt = auto ? ' about the ' + auto : '';\n    return saludo + ' We saw your comment' + autoTxt + '. It is available with $0 down payment options and immediate approval with passport or ITIN. What WhatsApp number can I send the photos and pricing breakdown to, or does today work to stop by and see it?';\n  } else {\n    const saludo = nombre ? '¡Hola ' + nombre + '!' : '¡Hola!';\n    const autoTxt = auto ? ' sobre el ' + auto : '';\n    return saludo + ' Vimos tu comentario' + autoTxt + '. Lo tenemos disponible con opciones desde $0 de enganche y aprobación inmediata con pasaporte o ITIN. ¿A qué número de WhatsApp te puedo compartir las fotos y corrida de pagos, o te queda bien pasar hoy a verlo?';\n  }\n})() }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false
      },
      "id": "a1b2c3d4-9999-4000-8000-000000000009",
      "name": "Formatear Respuestas Interés",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1700,
        320
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "comment_id",
              "value": "={{ $('Extraer Comentario y Metadatos').item.json.comment_id }}",
              "type": "string"
            },
            {
              "id": "b2",
              "name": "respuesta_publica",
              "value": "={{ $json.output?.idioma === 'en' ? 'Thanks for commenting! 🙌' : '¡Gracias por comentar! 🙌' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false
      },
      "id": "a1b2c3d4-aaaa-4000-8000-000000000010",
      "name": "Formatear Respuesta Sin Interés",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1700,
        540
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.comment_id }}/replies",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "={{ $json.respuesta_publica }}"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "a1b2c3d4-bbbb-4000-8000-000000000011",
      "name": "Meta Graph API: Responder Comentario",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/me/messages",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"recipient\": {\n    \"comment_id\": \"{{ $json.comment_id }}\"\n  },\n  \"message\": {\n    \"text\": {{ JSON.stringify($json.respuesta_dm) }}\n  }\n}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "a1b2c3d4-cccc-4000-8000-000000000012",
      "name": "Meta Graph API: Enviar DM Privado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2240,
        320
      ]
    }
  ],
