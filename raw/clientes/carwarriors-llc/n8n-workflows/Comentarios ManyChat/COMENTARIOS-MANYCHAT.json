    },
    {
      "id": "449e3914-950a-4723-b933-4c694654bf68",
      "name": "Interés Real?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.output.es_interes_real }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      }
    },
    {
      "id": "d29e8f35-9547-464c-8784-2edc11e806cb",
      "name": "Respuesta - Interés Real",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1400,
        180
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "es_interes_real",
              "name": "es_interes_real",
              "type": "boolean",
              "value": true
            },
            {
              "id": "respuesta_publica",
              "name": "respuesta_publica",
              "type": "string",
              "value": "={{ $json.output.idioma === 'en' ? 'Thanks for your interest! 🚗 We just sent you a private message with all the details.' : '¡Gracias por tu interés! 🚗 Te escribimos por mensaje privado con toda la información.' }}"
            },
            {
              "id": "respuesta_dm",
              "name": "respuesta_dm",
              "type": "string",
              "value": "={{ (() => {\n  const nombre = $('Normalizar Entrada').first().json.contact_nombre;\n  const isEn = $json.output.idioma === 'en';\n  const auto = ($json.output.vehiculo_mencionado || '').trim();\n\n  if (isEn) {\n    const saludo = nombre ? 'Hi ' + nombre + '!' : 'Hi!';\n    const autoTxt = auto ? ' about the ' + auto : '';\n    return saludo + ' We saw your comment' + autoTxt + '. It is available with $0 down payment options and immediate approval with passport or ITIN. What WhatsApp number can I send the photos and pricing breakdown to, or does today work to stop by and see it?';\n  } else {\n    const saludo = nombre ? '¡Hola ' + nombre + '!' : '¡Hola!';\n    const autoTxt = auto ? ' sobre el ' + auto : '';\n    return saludo + ' Vimos tu comentario' + autoTxt + '. Lo tenemos disponible con opciones desde $0 de enganche y aprobación inmediata con pasaporte o ITIN. ¿A qué número de WhatsApp te puedo compartir las fotos y corrida de pagos, o te queda bien pasar hoy a verlo?';\n  }\n})() }}"
            }
          ]
        },
        "includeOtherFields": false,
        "mode": "manual"
      }
    },
    {
      "id": "5dfc1833-562d-4ae7-bf27-83402a59bdc7",
      "name": "Responder a ManyChat",
      "type": "n8n-nodes-base.respondToWebhook",
