      }
    },
    {
      "id": "f9aa31bd-60e5-4e66-a204-99cbbbb0afbe",
      "name": "Clasificar Interés Real",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        840,
        300
      ],
      "parameters": {
        "attributes": {
          "attributes": [
            {
              "description": "Devuelve true SOLO si el comentario muestra interés real de compra de un vehículo: pregunta por precio, disponibilidad, financiamiento, quiere agendar una cita/visita, o pide información de un auto específico (marca, modelo, año). Devuelve false para comentarios genéricos, emojis, cumplidos (\"bonito auto\"), etiquetas a otras personas, comentarios no relacionados a intención de compra, o pedidos de regalos/sorteos/promociones gratuitas.",
              "name": "es_interes_real",
              "required": true,
              "type": "boolean"
            },
            {
              "description": "Código de idioma detectado en el texto del comentario: 'es' si está en español, 'en' si está en inglés. Si no puedes determinarlo con certeza o es otro idioma distinto, usa 'es' por defecto.",
              "name": "idioma",
              "required": true,
              "type": "string"
            },
            {
              "description": "Marca, modelo o tipo de vehículo mencionado en el comentario (ejemplo: 'Toyota Tacoma', 'Mustang', 'Corolla', 'camioneta', 'SUV'). Si no menciona ningún vehículo específico, devuelve cadena vacía.",
              "name": "vehiculo_mencionado",
              "required": false,
              "type": "string"
            }
          ]
        },
        "schemaType": "fromAttributes",
        "text": "={{ $json.comentario }}"
      }
    },
    {
      "id": "d09253a4-4419-4cd2-832d-560165a800dd",
      "name": "OpenRouter Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
