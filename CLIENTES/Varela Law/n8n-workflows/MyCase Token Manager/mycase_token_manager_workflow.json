      "parameters": {
        "jsCode": "const resp = $input.first().json;\n\nif (!resp.access_token || !resp.refresh_token) {\n  throw new Error('Respuesta inesperada de MyCase al refrescar token: ' + JSON.stringify(resp));\n}\n\nreturn [{\n  json: {\n    key: 'token',\n    accessToken: resp.access_token,\n    refreshToken: resp.refresh_token, // MyCase puede rotar el refresh_token\n    expiresAt: Date.now() + (resp.expires_in * 1000)\n  }\n}];"
