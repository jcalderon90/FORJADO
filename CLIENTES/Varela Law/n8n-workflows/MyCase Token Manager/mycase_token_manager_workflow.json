    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (!items.length || !items[0].json || !items[0].json.refreshToken) {\n  throw new Error('No hay refresh_token guardado en Mongo (coleccion mycase_tokens, key: \"token\"). Sembralo manualmente antes de usar este workflow.');\n}\n\nconst doc = items[0].json;\nconst now = Date.now();\nconst bufferMs = 60 * 60 * 1000; // renovar 1h antes de expirar\n\nconst valid = !!(doc.accessToken && doc.expiresAt && (doc.expiresAt - bufferMs) > now);\n\nreturn [{\n  json: {\n    valid,\n    accessToken: doc.accessToken || null,\n    refreshToken: doc.refreshToken\n  }\n}];"
      },
