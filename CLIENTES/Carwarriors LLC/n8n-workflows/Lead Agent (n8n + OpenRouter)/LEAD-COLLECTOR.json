        "collectionName": "chat_histories_lead",
        "databaseName": "Carwarriors",
        "contextWindowLength": 10
      },
      "type": "@n8n/n8n-nodes-langchain.memoryMongoDbChat",
      "typeVersion": 1,
      "position": [-1824, 352],
      "id": "6d19c130-7d05-4e2c-98a4-369b7f51612b",
      "name": "MongoDB Chat Memory",
      "credentials": { "mongoDb": { "id": "WvGe0WEIfm6NF1Qa", "name": "MongoDB Carwarriors" } }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output || '';\nconst ctx = $('SET CONTEXT').first().json;\ntry {\n  const start = raw.indexOf('{');\n  const end = raw.lastIndexOf('}') + 1;\n  if (start === -1 || end === 0) throw new Error('No JSON');\n  const parsed = JSON.parse(raw.substring(start, end).replace(/[\\n\\r]/g, ' '));\n  return [{\n    json: {\n      city: parsed.city || ctx.city_actual || '',\n      interes_vehiculo: parsed.interes_vehiculo || ctx.interes_vehiculo_actual || '',\n      metodo_pago: parsed.metodo_pago || ctx.metodo_pago_actual || '',\n      timing_compra: parsed.timing_compra || ctx.timing_actual || '',\n      idioma_preferido: parsed.idioma_preferido || ctx.idioma_actual || '',\n      resumen_ai: parsed.resumen_ai || ctx.resumen_actual || ''\n    }\n  }];\n} catch (e) {\n  return [{\n    json: {\n      city: ctx.city_actual || '',\n      interes_vehiculo: ctx.interes_vehiculo_actual || '',\n      metodo_pago: ctx.metodo_pago_actual || '',\n      timing_compra: ctx.timing_actual || '',\n      idioma_preferido: ctx.idioma_actual || '',\n      resumen_ai: ctx.resumen_actual || ''\n    }\n  }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1568, 128],
      "id": "38f6739b-d846-443b-8c41-ea1b8499f599",
      "name": "Parse Response"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            { "id": "chg-city", "leftValue": "={{ $json.city }}", "rightValue": "={{ $('SET CONTEXT').item.json.city_actual }}", "operator": { "type": "string", "operation": "notEquals" } },
            { "id": "chg-vehiculo", "leftValue": "={{ $json.interes_vehiculo }}", "rightValue": "={{ $('SET CONTEXT').item.json.interes_vehiculo_actual }}", "operator": { "type": "string", "operation": "notEquals" } },
            { "id": "chg-pago", "leftValue": "={{ $json.metodo_pago }}", "rightValue": "={{ $('SET CONTEXT').item.json.metodo_pago_actual }}", "operator": { "type": "string", "operation": "notEquals" } },
            { "id": "chg-timing", "leftValue": "={{ $json.timing_compra }}", "rightValue": "={{ $('SET CONTEXT').item.json.timing_actual }}", "operator": { "type": "string", "operation": "notEquals" } },
            { "id": "chg-idioma", "leftValue": "={{ $json.idioma_preferido }}", "rightValue": "={{ $('SET CONTEXT').item.json.idioma_actual }}", "operator": { "type": "string", "operation": "notEquals" } },
            { "id": "chg-resumen", "leftValue": "={{ $json.resumen_ai }}", "rightValue": "={{ $('SET CONTEXT').item.json.resumen_actual }}", "operator": { "type": "string", "operation": "notEquals" } }
          ],
          "combinator": "or"
        },
        "options": {}
      },
